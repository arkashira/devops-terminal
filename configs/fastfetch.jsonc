{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "apple", "padding": { "top": 1, "right": 4 } },
  "display": { "separator": "  " },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    "separator",
    { "type": "os",       "key": "  OS",     "keyColor": "red" },
    { "type": "kernel",   "key": "  Kernel", "keyColor": "yellow" },
    { "type": "uptime",   "key": " 󰅐 Uptime", "keyColor": "green" },
    { "type": "packages", "key": " 󰏖 Pkgs",   "keyColor": "cyan" },
    { "type": "terminal", "key": "  Term",   "keyColor": "blue" },
    { "type": "cpu",      "key": "  CPU",    "keyColor": "magenta" },
    { "type": "memory",   "key": "  Mem",    "keyColor": "red" },
    { "type": "disk",     "key": " 󰋊 Disk",   "keyColor": "yellow" },
    { "type": "localip",  "key": " 󰩟 IP",     "keyColor": "green", "showIpv6": false, "compact": true },
    "break",
    "colors"
  ]
}
