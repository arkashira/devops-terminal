# vhs assets/demo.tape → assets/demo.gif
Output assets/demo.gif
Set Shell "zsh"
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 15
Set Width 1100
Set Height 620
Set Theme "Catppuccin Mocha"
Set Padding 16
Set TypingSpeed 55ms
Hide
Type "KIRO_TERM=1; source ~/.zshrc"
Enter
Sleep 4s
Type "clear"
Enter
Sleep 500ms
Show
Sleep 800ms
Type "ll"
Enter
Sleep 2s
Type "kgp"
Sleep 900ms
Type " "
Sleep 1.6s
Ctrl+U
Type "cd con"
Tab
Sleep 2s
Enter
Sleep 800ms
Enter
Sleep 1.2s
Type "tokei"
Enter
Sleep 2.5s
